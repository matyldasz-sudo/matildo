    "    m = 0\n",
    "    miejsc=1\n",
    "    while n > 0:\n",
    "        cyfra = n % 10\n",
    "        if cyfra % 2 == 1:\n",
    "            m += cyfra * miejsc\n",
    "            miejsc *= 10\n",
    "        n //= 10\n",
    "    return m\n",
    "print(skrot(1023456788))\n",
    "def nwd(a, b):\n",
    "    while b != 0:\n",
    "        a, b = b, a%b\n",
    "    return a\n",
    "with open(\"skrot2.txt\", \"r\") as plik:\n",
    "    with open(\"wyniki3_3.txt\", \"w\") as zapis:\n",
    "        for linijka in plik:\n",
    "            liczba = int(linijka)\n",
    "            if nwd(liczba, skrot(liczba)) == 7:\n",
    "                zapis.write(linijka)\n",
